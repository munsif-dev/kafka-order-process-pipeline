{
  "type": "record",
  "name": "Order",
  "namespace": "com.bigdata.orders",
  "doc": "Schema definition for purchase transaction orders",
  "fields": [
    {
      "name": "orderId",
      "type": "string",
      "doc": "Unique identifier for the order (e.g., '1001', '1002')"
    },
    {
      "name": "product",
      "type": "string",
      "doc": "Name of the purchased item (e.g., 'Item1', 'Laptop')"
    },
    {
      "name": "price",
      "type": "float",
      "doc": "Price of the product (randomized positive float)"
    }
  ]
}
